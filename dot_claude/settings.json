{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_WORKFLOWS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_TRACES_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://trace.wandb.ai/agents/otel/v1/traces",
    "OTEL_RESOURCE_ATTRIBUTES": "wandb.entity=npratt,wandb.project=claude-code,gen_ai.agent.name=claude-code"
  },
  "otelHeadersHelper": "/Users/npratt/.claude/bin/agent-lens-otel-headers.sh",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/npratt/git"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "kynes-guide@cw-claude-code-plugins": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "skillOverrides": {
    "amps-bites": "off",
    "cc-scout": "off",
    "diataxis-documentation": "off",
    "grug-review": "off",
    "repo-explore": "off",
    "thermo-nuclear-code-quality-review": "off"
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "cw-claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "coreweave/agent-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/npratt/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
