dot_codex/models_cache.json
dot_codex/cloud-requirements-cache.json
dot_codex/version.json
dot_codex/logs*.sqlite*
dot_codex/state*.sqlite*
dot_codex/cache/
dot_codex/log/
dot_codex/sessions/
dot_codex/shell_snapshots/
dot_codex/.tmp/
