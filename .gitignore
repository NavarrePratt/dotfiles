# Local secret material
dot_config/dotfiles/local/env.zsh
dot_config/dotfiles/local/teleport.zsh
dot_config/dotfiles/local/*.secret.zsh
*.pem
*.key
.env

# Chezmoi and local editor state
.chezmoi*
!.chezmoiignore
.DS_Store
*.swp
*.swo

# Codex runtime state. Keep only intended config, rules, and approved skills.
dot_codex/auth.json
dot_codex/history.jsonl
