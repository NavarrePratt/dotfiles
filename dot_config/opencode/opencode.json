{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "wandb/zai-org/GLM-5.2",
  "provider": {
    "wandb": {
      "name": "Weights & Biases Inference",
      "npm": "@ai-sdk/openai-compatible",
      "env": [
        "WANDB_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.inference.wandb.ai/v1",
        "headers": {
          "OpenAI-Project": "{env:WANDB_INFERENCE_PROJECT}"
        }
      },
      "models": {
        "zai-org/GLM-5.2": {
          "name": "Z.AI GLM 5.2",
          "cost": {
            "input": 1.39,
            "output": 4.40,
            "cache_read": 0.26
          },
          "limit": {
            "context": 262000,
            "output": 131072
          }
        }
      }
    }
  }
}
