{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "wandb/zai-org/GLM-5.2",
  "instructions": [
    "instructions/cross-model-mcp.md",
    "~/.claude/rules/dependency-selection.md",
    "~/.claude/rules/kubernetes-safety.md"
  ],
  "provider": {
    "wandb": {
      "name": "Weights & Biases Inference",
      "npm": "@ai-sdk/openai-compatible",
      "env": [
        "WANDB_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.inference.wandb.ai/v1",
        "headers": {
          "OpenAI-Project": "{env:WANDB_INFERENCE_PROJECT}"
        }
      },
      "models": {
        "zai-org/GLM-5.2": {
          "name": "Z.AI GLM 5.2",
          "cost": {
            "input": 1.39,
            "output": 4.40,
            "cache_read": 0.26
          },
          "limit": {
            "context": 262000,
            "output": 131072
          }
        }
      }
    }
  },
  "mcp": {
    "slack": {
      "type": "remote",
      "url": "http://127.0.0.1:3003/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SLACK_MCP_API_KEY}"
      }
    },
    "codex": {
      "type": "local",
      "command": ["codex", "mcp-server"],
      "enabled": true,
      "timeout": 1200000
    },
    "cross-agent": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/NavarrePratt/cross-agent-mcp[claude]", "cross-agent-mcp"],
      "enabled": true,
      "timeout": 1200000
    }
  },
  "tools": {
    "cross-agent_opencode_*": false
  }
}
